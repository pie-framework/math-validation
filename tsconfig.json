{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "strict": false,
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "moduleResolution": "Node",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "lib", "**/__tests__/**", "src/fixtures", "playground", "old-stuff", "wip-src" ]
}
